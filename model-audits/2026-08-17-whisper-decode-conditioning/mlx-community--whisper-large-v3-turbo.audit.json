 "evidence": {
  "supersedes_audit_id": "voicestudio-20260802-whisper-large-a4aaeec0",
  "supersedes_contract_hash": "sha256:5989146a07091c6f03584531e6c54df3db4ef5c045f88cda5d10a10b45e76a39",
  "reason": "The v1 audit pinned the checkpoint and the caller-facing controls but had no field for decode parameters, so the runtime ran with mlx-audio's default condition_on_previous_text=True. That default feeds each 30-second window's own output back as the prompt for the next window, making hallucination self-reinforcing. Because the language token conditions only the start of decoding and never restricts the decoder vocabulary, an explicitly English request could still emit CJK, Cyrillic and Hebrew text. This audit pins the decode policy into the contract so any future change to it changes the hash.",
  "defect_population": {
   "source": "the owner's own rendered subtitle corpus, 4032 .srt files",
   "files_with_cjk_cyrillic_or_hebrew_in_english_content": "17%",
   "files_with_u_fffd_replacement_characters": "4.4%",
   "mojibake": "0% — genuine model output, not an encoding fault",
   "content_dependence": "sleep/calm content 50-62% affected, spoken explainers 16-18%",
   "downstream_impact": "transcripts feed image-prompt generation, so an invented sentence produces a wrong image; this is not a cosmetic subtitle defect"
  },
  "method": {
   "harness": "same audio, same cached checkpoint, same language='en', one decode option varied at a time; runs serialized, never parallel, on one 16 GB Apple Silicon machine",
   "arms": {
    "base": "as shipped in v1 (condition_on_previous_text defaulted to True)",
    "cond": "condition_on_previous_text=False",
    "supp": "suppress_tokens = [-1] + 7562 token ids whose decoded text contains CJK/Cyrillic/Hebrew/Hangul/Arabic/Thai/Khmer (-1 retained so the non-speech set is appended to, not replaced)",
    "both": "cond + supp"
   },
   "scoring": "each arm scored against the ground-truth narration script the voice actually read (.md and .docx sources in the owner's project tree), by word-level longest-common-subsequence alignment. 'missed_truth_words' are script words absent from the transcript; 'invented_words' are transcript words with no counterpart in the script. Base-vs-arm diffing alone cannot distinguish removing a hallucination from removing real speech; scoring against the script can.",
   "sample": "21 chapters across all six of the owner's content brands; 2 excluded because their stored script does not match the rendered audio (a content-pipeline drift in those episodes, unrelated to transcription), leaving 19 scored chapters and 7704 ground-truth words"
  },
